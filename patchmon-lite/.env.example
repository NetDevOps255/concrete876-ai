# ─────────────────────────────────────────────────────
# PatchMon Lite — Environment Configuration
# Copy to .env and fill in all values before running
# ─────────────────────────────────────────────────────

# ── Security (REQUIRED) ───────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-use-openssl-rand-hex-32

# API key for curl/external integrations
# Generate with: openssl rand -hex 32
API_KEY=change-me-use-openssl-rand-hex-32

# Admin UI credentials
# Set username (default: admin)
ADMIN_USERNAME=admin
# Generate hash: python3 scripts/hash_password.py
# Example hash below is for the string "changeme" — CHANGE THIS
ADMIN_PASSWORD_HASH=

# Allowed frontend origins (comma-separated, no wildcard in production)
# For homelab: use your actual frontend IP/hostname
ALLOWED_ORIGINS=http://localhost:3000,http://192.168.1.x:3000

# ── Telegram (optional) ──────────────────────────────
# Get from @BotFather
TELEGRAM_BOT_TOKEN=
# Your group/channel chat ID (starts with -100...)
TELEGRAM_CHAT_ID=

# ── Proxmox API (optional) ───────────────────────────
# Format: host:port  (no https://)
PROXMOX_HOST=192.168.1.100:8006
# Format: user@realm!tokenid
PROXMOX_TOKEN_ID=root@pam!patchmon
PROXMOX_TOKEN_SECRET=
PROXMOX_NODE=pve

# ── SSH ───────────────────────────────────────────────
SSH_DEFAULT_USER=root

# ── Scheduler Intervals (seconds) ────────────────────
PATCH_CHECK_INTERVAL=3600
DOCKER_CHECK_INTERVAL=3600
PROXMOX_SYNC_INTERVAL=300

# ── Auth Rate Limiting ────────────────────────────────
# Max login attempts per IP per minute
AUTH_RATE_LIMIT=10
