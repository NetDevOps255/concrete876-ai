# Homebox instance URL (no trailing slash)
HOMEBOX_URL=http://192.168.1.100:7745

# Authentication - use ONE of the following options:

# Option 1: API token (preferred for long-running services)
HOMEBOX_TOKEN=your-api-token-here

# Option 2: Username/password (server will auto-authenticate and refresh)
# HOMEBOX_USERNAME=admin@example.com
# HOMEBOX_PASSWORD=your-password-here

# Optional: SSL verification (set to false for self-signed certs)
HOMEBOX_SSL_VERIFY=true

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
