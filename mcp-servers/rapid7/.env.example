# Rapid7 MCP Server — Environment Variables
# Copy this file to .env and fill in your values before building/running.

# -----------------------------------------------------------------------
# REQUIRED
# -----------------------------------------------------------------------

# Rapid7 Insight Platform API key
# Generate at: InsightIDR → Settings → API Keys → Generate New User Key
RAPID7_API_KEY=your_api_key_here

# Region code — matches the subdomain in your InsightIDR URL
# Options: us | us2 | us3 | eu | ca | au | ap
RAPID7_REGION=us
